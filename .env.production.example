# Template only: copy to .env.production on the server and restrict file permissions.
# Do not reuse sandbox credentials, certificates, approvers or database data.
PORTAL_BIND_IP=
PORTAL_PORT=8081
# Internal HTTP origin, including port. Restrict access to the corporate network.
FRONTEND_ORIGIN=

MYSQL_DATABASE=defusion_bcp
MYSQL_USER=defusion_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SAP_BASE_URL=
SAP_COMPANY_DB=
# Keep true when SAP is addressed by a DNS name present in its certificate.
# Use false only when the mandatory SAP URL uses an IP not listed in the certificate.
SAP_TLS_REJECT_UNAUTHORIZED=true

BCP_ENVIRONMENT=PRODUCTION
BCP_PAYMENTS_ENABLED=false
BCP_ALLOW_DOCUMENT_REVERSAL=false
BCP_SANDBOX_LEGACY_RSA_ENABLED=false
BCP_MULTIPLE_URL=https://credinetweb.bcp.com.bo/ApiCwV2/api/APIAuth/ProcessMultiple
BCP_EXTRACTS_URL=https://credinetweb.bcp.com.bo/ApiCwV2/api/APIAuth/GetExtracts
BCP_COMPANY_ID=
BCP_BASIC_USERNAME=
BCP_BASIC_PASSWORD=
BANK_DIFFUSION_PASSWORD=
BANK_DIFFUSION_DOCUMENT_NUMBER=
BANK_DIFFUSION_DOCUMENT_TYPE=
BANK_DIFFUSION_DOCUMENT_EXTENSION=
# Reference only: human access supplied by BCP; not sent in the API request.
BCP_GENERIC_USER_ACCESS=
BANK_DIFFUSION_FUND_SOURCE=
BANK_DIFFUSION_FUND_DESTINATION=
BANK_DIFFUSION_DESCRIPTION=
BANK_DIFFUSION_SEND_VOUCHERS=
# JSON array of real approvers, e.g. [{"idc":"REAL-ID","type":1}]. No sandbox defaults.
BANK_DIFFUSION_APPROVERS_JSON=[]

# Directory on the SERVER containing the three production bank certificate files.
BCP_CERT_HOST_DIRECTORY=
# Paths INSIDE Docker. Use the actual filenames supplied by BCP.
BCP_AUTH_CERTIFICATE_PATH=/run/bcp-certs/AUTH_PROD.pfx
BCP_AUTH_CERTIFICATE_PASSWORD=
BCP_SIGNING_CERTIFICATE_PATH=/run/bcp-certs/ENC_PROD.pfx
BCP_SIGNING_CERTIFICATE_PASSWORD=
BCP_BUSINESS_CERTIFICATE_PATH=/run/bcp-certs/BUSINESS_PROD.cer
BCP_TLS_PROTOCOLS=TLSv1.3
BCP_CONNECT_TIMEOUT=10s
BCP_READ_TIMEOUT=60s
