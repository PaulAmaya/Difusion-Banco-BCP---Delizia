# Copie este archivo como .env y cambie todas las contraseñas antes de iniciar.
MYSQL_DATABASE=defusion_bcp
MYSQL_USER=defusion_app
MYSQL_PASSWORD=cambiar-clave-mysql
MYSQL_ROOT_PASSWORD=cambiar-clave-root-mysql

SAP_BASE_URL=https://servidor-sap:50000/b1s/v2
SAP_COMPANY_DB=EMPRESA_SAP
SAP_TLS_REJECT_UNAUTHORIZED=true
SAP_CONNECT_TIMEOUT=10s
SAP_READ_TIMEOUT=30s

BCP_COMPANY_ID=2295
BCP_ENVIRONMENT=SANDBOX
BCP_EXTRACTS_URL=https://www99.bancred.com.bo/ApiCwV2/api/APIAuth/GetExtracts
# Cabecera del preparador Credinet, distinta de Basic Auth.
BANK_DIFFUSION_PASSWORD=
BANK_DIFFUSION_DOCUMENT_NUMBER=
BANK_DIFFUSION_DOCUMENT_TYPE=Q
BANK_DIFFUSION_DOCUMENT_EXTENSION=LP
BANK_DIFFUSION_FUND_SOURCE=Ambiente sandbox
BANK_DIFFUSION_FUND_DESTINATION=Ambiente de pruebas
BANK_DIFFUSION_DESCRIPTION=Descripcion prueba
BANK_DIFFUSION_SEND_VOUCHERS=
BANK_DIFFUSION_APPROVERS_JSON=
BANK_DIFFUSION_SOURCE_ACCOUNT=
# Extractos BCP: si se deja vacio, la clave usa BANK_DIFFUSION_PASSWORD.
BANK_STATEMENT_PASSWORD=
BANK_STATEMENT_DOCUMENT_NUMBER=
# Solo sandbox. Habilitar expresamente despues de configurar las credenciales.
BCP_PAYMENTS_ENABLED=false
BCP_ALLOW_DOCUMENT_REVERSAL=false
BCP_MULTIPLE_URL=https://www99.bancred.com.bo/ApiCwV2/api/APIAuth/ProcessMultiple
BCP_BASIC_USERNAME=
BCP_BASIC_PASSWORD=
BCP_TLS_PROTOCOLS=TLSv1.3
# Temporary sandbox-only Postman compatibility: true requires TLSv1.2 and API_DESA.pfx.
# Uses isolated curl/OpenSSL; never changes JVM security or disables certificate verification.
BCP_SANDBOX_LEGACY_RSA_ENABLED=false
BCP_CONNECT_TIMEOUT=10s
BCP_READ_TIMEOUT=60s
# Opcional si el banco exige mTLS: archivo dentro de bank-auth-certs/.
# Carpeta en Windows que contiene el PFX usado por Postman. Si queda vacia, usa ./bank-auth-certs.
BCP_AUTH_CERT_HOST_DIRECTORY=
# Ruta dentro de Docker, nunca C:/Users/... Ejemplo: /run/bcp-auth/API_DESA.pfx
BCP_AUTH_CERTIFICATE_PATH=
BCP_AUTH_CERTIFICATE_PASSWORD=
BCP_BUSINESS_CERT_HOST_PATH="C:/ruta/certificados/BUSINESS.cer"
BCP_SIGNING_CERT_HOST_PATH="C:/ruta/certificados/ENC_DESA.pfx"
BCP_SIGNING_CERTIFICATE_PASSWORD=cambiar-password-del-certificado

FRONTEND_PORT=5174
BACKEND_PORT=8081
MYSQL_PORT=3307
